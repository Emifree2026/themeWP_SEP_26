{
  "key": "CD3-17",
  "title": "Elbow, Mitered, 45 Degree",
  "reference": "(Idelchik 1986, Diagram 6-5) — K = 0.45 closed-form (mitered 45°)",
  "geometry": {
    "D": {
      "label": "Diameter",
      "min": 75,
      "max": 1500,
      "default": 300,
      "unit": "mm"
    },
    "Q": {
      "label": "Flow Rate",
      "min": 5,
      "max": 9999999,
      "default": 700,
      "unit": "L/s"
    }
  },
  "equations": [
    {
      "out": "A",
      "expr": "(PI/4)*(D/ADC)^2"
    },
    {
      "out": "Vo",
      "expr": "Q/A*VELC"
    },
    {
      "out": "Pv",
      "expr": "(Vo/VPC)^2"
    },
    {
      "out": "Co",
      "expr": "0.45"
    },
    {
      "out": "Po",
      "expr": "Co*Pv"
    }
  ],
  "outputs": {
    "Po": "Pa"
  }
}