{
  "key": "CR3-1",
  "title": "Elbow, Smooth Radius without Vanes",
  "reference": "(Idelchik 1986, Diagram 6-1)",
  "geometry": {
    "W": {
      "label": "Width",
      "min": 25,
      "max": 2500,
      "default": 300,
      "unit": "mm"
    },
    "H": {
      "label": "Height",
      "min": 25,
      "max": 2500,
      "default": 300,
      "unit": "mm"
    },
    "r": {
      "label": "Centerline Radius",
      "min": 25,
      "max": 1500,
      "default": 300,
      "unit": "mm"
    },
    "Theta": {
      "label": "Angle",
      "min": 0,
      "max": 180,
      "default": 90,
      "unit": "deg"
    },
    "Q": {
      "label": "Flow Rate",
      "min": 5,
      "max": 9999999,
      "default": 700,
      "unit": "L/s"
    }
  },
  "equations": [
    {
      "out": "A",
      "expr": "H*W/ARC"
    },
    {
      "out": "Vo",
      "expr": "Q/A*VELC"
    },
    {
      "out": "Pv",
      "expr": "(Vo/VPC)^2"
    },
    {
      "out": "Cp",
      "expr": "fcn((H/W),(r/W),1)"
    },
    {
      "out": "K",
      "expr": "fcn(Theta,2)"
    },
    {
      "out": "Co",
      "expr": "Cp*K"
    },
    {
      "out": "Po",
      "expr": "Co*Pv"
    }
  ],
  "outputs": {
    "Po": "Pa"
  }
}